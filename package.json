{
  "name": "jschof-dev",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "pnpm build:components && NODE_OPTIONS=--max-old-space-size=8192 npx @11ty/eleventy --serve",
    "build": "pnpm build:components && npx @11ty/eleventy",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:components": "pnpm -r --filter './component/*' run build",
    "dev:components": "pnpm -r --parallel --filter './component/*' run dev",
    "dev:netlify": "netlify dev --filter jschof-dev",
    "dev:full": "pnpm run \"/^dev:(components|netlify)$/\"",
    "og:gen": "node scripts/generate-post-images.js",
    "prepare": "git config core.hooksPath .githooks",
    "release": "pnpm build:components && pnpm changeset version && pnpm changeset publish"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@changesets/cli": "^2.31.0",
    "esbuild": "^0.28.1",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.4",
    "@jschofield/code-highlight": "workspace:*",
    "@jschofield/link-preview": "workspace:*",
    "@jschofield/play-ground": "workspace:*",
    "@jschofield/quick-search": "workspace:*",
    "@jschofield/reading-list": "workspace:*",
    "@jschofield/repl-playground": "workspace:*",
    "@jschofield/scroll-explain": "workspace:*",
    "@lezer/highlight": "^1.2.3",
    "@replit/codemirror-vim": "^6.3.0",
    "baseline-status": "^1.1.1",
    "codemirror": "^6.0.2",
    "date-fns": "^4.4.0",
    "gaxios": "^7.1.5",
    "google-auth-library": "^10.9.0",
    "google-logging-utils": "^1.1.4",
    "happy-dom": "^20.10.6",
    "lit": "^3.3.3",
    "prettier": "^3.9.4",
    "prettier-plugin-svelte": "^3.4.0",
    "shiki": "^4.3.0"
  }
}
